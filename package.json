{
  "name": "hexcore",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbo -p 3000",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ui": "node scripts/check-ui-spec.mjs",
    "check:deps": "node scripts/check-lockfile-integrity.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:ui && npm run test && npm run check:deps && npm run check:workspace",
    "ci": "npm run check && npm run docs:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:report": "node scripts/eval-report.mjs",
    "eval:nogate": "vitest run --config vitest.eval.nogate.config.mts",
    "e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "docs:check": "node scripts/check-doc-links.mjs .",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "release:start": "node scripts/release.mjs start",
    "release:check": "node scripts/release.mjs check",
    "release:finish": "node scripts/release.mjs finish",
    "release:tag": "node scripts/release.mjs tag",
    "release:notes": "node scripts/release.mjs notes",
    "release:status": "node scripts/release.mjs status",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "eval:diff": "node evals/diff.mjs",
    "eval:trend": "node evals/trend.mjs",
    "eval:nightly": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nightly-eval.ps1",
    "check:workspace": "node scripts/check-workspace.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.0",
    "@ant-design/icons": "^5.5.1",
    "@ant-design/nextjs-registry": "1.3.0",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "ai": "^4.1.0",
    "antd": "^5.21.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "docx": "^9.10.0",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "15.5.28",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.4",
    "pptxgenjs": "^3.12.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.28",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "jsondiffpatch": ">=0.7.2"
    }
  }
}

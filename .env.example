# ===== PostgreSQL（全量业务数据存放处：用户/模型/会话/知识库/用量/日志）=====
# 默认连接本机 PG；如用下方 docker-compose，库名 ai_agent_platform 会自动创建
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_agent_platform

# ===== Redis（可选：限流 / 异步队列；不配置则自动降级，功能不受影响）=====
# 限流会退回进程内计数；索引任务改为进程内后台执行
REDIS_URL=redis://localhost:6379

# ===== Docker 宿主机端口映射（仅 docker compose 方式生效）=====
# 本机已经跑着 PostgreSQL / Redis、占着 5432 / 6379 时，改这两个值避开冲突再启动。
# 只影响「从宿主机连容器」用的端口，应用容器内部仍走服务名 postgres:5432 / redis:6379。
# POSTGRES_PORT=5433
# REDIS_PORT=6380

# ===== 向量维度（可选，pgvector 列维度；默认 384）=====# 需与所用 embedding 模型的输出维度一致：MiniMax embo-01=1536、OpenAI text-embedding-3-small=1536、BGE-M3=1024
# 改动后重启会重建向量列并清空旧向量，再到「知识库」页点「重新索引」即可
# 知识库可单独指定 embedding 模型（默认 auto 跟随全局候选链）；切换模型会自动清空并重建该库向量
EMBED_DIM=384

# ===== JWT 签名密钥（必须改！）=====
# 注意：它同时用于派生「模型 API Key / 连接器配置」的 AES 加密密钥。
# 生产环境（NODE_ENV=production）若该值为空、少于 16 字符、或仍是下面这个 change-me 占位值，
#   应用会拒绝提供服务（所有请求 500 并打印修复指引）——因为弱密钥等于公开密钥：
#   JWT 可被伪造（可冒充管理员）、加密凭据可被解密。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 仅内网临时自测可设 ALLOW_INSECURE_SECRET=1 跳过该校验（不推荐，启动会持续告警）。
# 一旦修改，之前用旧密钥加密的数据将无法解密（模型 Key / 连接器配置需要重新填写）。
APP_SECRET=change-me-to-a-long-random-string

# ===== 会话 Cookie 的 Secure 标记（可选）=====
# 生产环境默认自动开启（Cookie 只在 HTTPS 下回传）。内网纯 HTTP 部署如出现「登录后立刻掉线」，设为 0 关闭。
# COOKIE_SECURE=0

# ===== 额外允许的采集点来源（可选，CSRF 校验用）=====
# 接口已按 Sec-Fetch-Site / Origin 做同源校验；若前置了反向代理且改写了 Host，
# 把对外访问的完整 origin 写进这里（逗号分隔），避免正常写入请求被误判为跨站。
# APP_ORIGINS=https://ai.example.com,https://ai.example.cn

# ===== 本地 Ollama 地址（可选，用于本地模型）=====
OLLAMA_BASE_URL=http://localhost:11434

# ===== 云端模型 Key（仅当使用 OpenAI/DeepSeek 等时填写；也可在后台模型配置里填）=====
OPENAI_API_KEY=
MINIMAX_API_KEY=
# MiniMax 的向量模型 embo-01 输出 1536 维，用它时请把上面的 EMBED_DIM 改成 1536

# 国产模型 Key（可选）：填了就能在后台直接选对应服务商，不必手填 baseURL
# 阿里云百炼（通义千问；向量模型 text-embedding-v3 为 1024 维）
DASHSCOPE_API_KEY=
# 硅基流动（Qwen / DeepSeek / BGE-M3，OpenAI 兼容）
SILICONFLOW_API_KEY=
# 智谱（GLM 系列，OpenAI 兼容）
ZHIPU_API_KEY=

# ===== 演示模式（DEMO_MODE）=====
# 不配置任何模型 Key 也能把整套流程跑通：对话、知识库检索、引用来源、拒答。
# 实现方式是用本地确定性回答器替代大模型（从检索到的资料里抽取句子，不走网络、不计费）。
# 适合：clone 后立刻试用、截图、演示给别人看。
#
# 取值：
#   1  = 强制演示（即使配了真实模型 Key 也走本地回答器）
#   未设置 = 自动：库里没有任何可用对话模型时才启用（配了 Key 就不会误用演示模式）
#   0  = 显式关闭
#
# 注意：演示模式不懂语义，只会做词面匹配抽取。它的作用是「证明链路通了」，不是「证明模型强」。
# DEMO_MODE=1

# ===== SSRF 防护（默认开启，推荐保持）=====
# 连接器 / 能力 / MCP 端点的 URL 由用户填写、服务端代发请求，默认禁止指向内网与云元数据地址。
# 本地开发要连 localhost 的自建服务（如本机 MCP）时临时设为 true，生产环境不要开。
# SSRF_ALLOW_PRIVATE=false

# ===== 提示注入护栏（可选）=====
# 默认 false：命中注入特征只记录日志并在 System Prompt 里追加防御说明，不拦截用户输入（避免误伤正常提问）。
# 设为 true 时，疑似「指令覆盖」类输入直接返回 400。
# GUARDRAIL_BLOCK=false

# ===== MCP 协议版本（可选）=====
# 客户端默认按 2025-06-18 握手；若目标 MCP 服务版本较旧，按其文档改这里。
# MCP_PROTOCOL_VERSION=2025-06-18

# ===== 定时任务调度（可选）=====
# 多副本部署时，除主副本外其余副本全部设为 false：Redis 锁只防「同一次触发重复执行」，
# 防不了 N 个副本各起一套 cron 空转。单实例部署无需设置（默认启用）。
# SCHEDULER_ENABLED=true

# ===== 代码沙箱（可选）=====
# 默认在 worker_threads 中执行：可强杀同步死循环、可限内存（防止一段脚本拖垮整个服务进程）。
# 设为 vm 退回进程内执行——隔离性更弱，仅用于调试或运行时不支持 worker 的环境。
# SANDBOX_MODE=worker
# SANDBOX_TIMEOUT_MS=2000
# SANDBOX_MEM_MB=64

# ===== 重排模型（可选，RAG 精排）=====
# 在后台模型配置里给某个模型的 capabilities 加上 rerank（并为它填 Key/baseUrl），
# 检索就会把 top-12~18 候选交给交叉编码器精排后再取 top-k。
# 未配置时完全不走网络，检索仍用「向量 0.75 + 词法 0.25」的融合排序。
# 接口按 Jina / Cohere v2 / SiliconFlow 共用的 POST {baseUrl}/rerank 格式调用。
# RERANK_TIMEOUT_MS=3000

# ===== 模型分档（V8 · 可选）=====
# 后台/收尾类任务（记忆抽取、会话摘要、工具结果收尾合成、judge 抽查）会挑「有价格数据的最便宜对话模型」；
# 主对话推理始终用主模型，永不降档。模型表里 price_in / price_out 全为 0（无价格数据）时不降档，直接回退主模型。
# MODEL_TIERING=off              # 关闭分档，所有任务回退主模型
# MODEL_CHEAP_ID=<模型id>        # 指定「便宜档」用哪个模型，优先于按价格自动挑选
# MODEL_TIER_JUDGE=<模型id>      # 按任务覆盖（任务名：SUMMARY / MEMORY_EXTRACT / SYNTHESIZE / JUDGE / CRITIC）

# ===== 运行时 LLM-judge（V8 · 可选）=====
# 独立上下文抽查最终回答：只喂「问题 + 工具结果 + 回答」，不看推理过程。
# 默认关闭——每次抽查都是一次真实计费调用。仅在「本轮调用过 connector / 能力 / 技能 / PPT / 读文件」时触发，
# 结论只写 eval_runtime 日志，不改写已交付的回答，也不触发重试。
# RUNTIME_JUDGE=on

# ===== 单轮对话 Token 预算（V8.2）=====
# 一次对话轮次（含工具多步）累计消耗的上限，超出即中止生成并保留半截回答。
# 默认 60000。原实现只有请求前的「输入 + 400」估算，而额度扣减在事后，等于没有预算；
# 上限 5 步 × 8192 输出 token 时单轮可烧掉估算值的数十倍。
# 设为 0 关闭闸门（应急用，不建议长期关）。
# CHAT_TURN_TOKEN_BUDGET=60000

# ===== 版本号（可选，健康检查回显）=====
# `GET /api/health?full=1` 会把它放进 version 字段，便于确认线上跑的是哪一版。
# 不设置时回退 npm_package_version，再回退 unknown。
# APP_VERSION=8.2.0

# ===== 混合召回开关（V8.2 · C3）=====
# pgvector 快路径默认双路召回：向量近邻（`<=>`）+ 词法命中（中文二元组 / 英文整词），
# 两路结果用 RRF 倒数排名融合。加词法腿的原因：查询里带确切标识符（振动、温度、错误码、
# 接口名）时，纯语义检索会把「语义相近但没写这个词」的片段排到前面。
# 词法腿是 O(行数 × 词法项数) 的顺序扫描、走不了索引，知识库到十万片级应改外部检索。
# 该值设为 off 可一键退回纯向量召回，不必改代码、不必发版。
# RAG_HYBRID=off

# ===== 工具幂等账本（V8.2 · C1）=====
# 写工具（run_skill / generate_ppt / create_todo / propose_skill_install / 非 GET 的连接器调用）
# 会在 idempotency_keys 表里登记幂等键，防止模型重试时重复执行、重复产生副作用。
# memory：只用进程内 Map（压测 / 无库环境）；db：强制走账本（CI 验证落库路径）；
# 不设置：单测环境走 memory，其余走 db（DB 异常时自动退回 memory 并打 warn）。
# IDEMPOTENCY_STORE=db

